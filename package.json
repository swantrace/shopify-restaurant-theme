{
  "name": "datomar",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "npm@11.6.1",
  "repository": "git@github.com:zdnblueme/Datomar.git",
  "author": "Qixuan Hong <frederickhong.5@gmail.com>",
  "license": "MIT",
  "scripts": {
    "build": "vite build --mode unminified && vite build --mode minified",
    "dev": "vite build --mode unminified --watch",
    "lint": "biome lint src vite.config.js",
    "lint:fix": "biome lint --write src vite.config.js",
    "format": "prettier --write src vite.config.js biome.json package.json README.md",
    "format:check": "prettier --check src vite.config.js biome.json package.json README.md",
    "check": "npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "async.maplimit": "^0.5.2",
    "axios": "^0.20.0",
    "bootstrap.native": "^3.0.9",
    "glider-js": "^1.7.3",
    "haunted": "^4.7.0",
    "js-cookie": "^2.2.1",
    "lit-html": "^1.3.0",
    "lodash": "^4.17.20",
    "macy": "^2.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "prettier": "latest",
    "sass": "latest",
    "vite": "latest"
  }
}
